{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ぴこぴこ作文帳",
  "version": "0.1.0",
  "identifier": "dev.pico.sakubun",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:43123",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ぴこぴこ作文帳",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
